# GitHub LinkedIn AI Publisher - Environment Configuration
# NOTE: Secrets (API keys, OAuth tokens) MUST NOT be stored here.
# Sensitive credentials are automatically stored in Windows Credential Manager via keyring.

# Server Configuration (strictly localhost)
HOST=127.0.0.1
PORT=8000
DEBUG=false
APP_ENV=development

# Database Settings
DATABASE_URL=sqlite:///./data/publisher.db

# Storage
DATA_DIR=./data
SCREENSHOTS_DIR=./data/screenshots

# Web Research Settings
DEFAULT_SEARCH_PROVIDER=none
SEARCH_ENABLED=false

# LinkedIn OAuth App Settings (Non-secret application identifiers)
# Client secret must be entered via UI and stored in Windows Credential Manager
LINKEDIN_CLIENT_ID=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/linkedin/callback
# LinkedIn REST API Version (YYYYMM format, e.g. 202610). Defaults automatically to active version if blank.
LINKEDIN_API_VERSION=

